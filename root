
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090909">
  <meta name="description" content="Discover Auraè — a contemporary jewellery collection defined by quiet luxury, sculptural forms and timeless elegance.">
  <title>Auraè — Jewellery Beyond Trends</title>

  <!-- Elegant typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    /* ========== GLOBAL STYLES ========== */
    :root {
      --bg: #090909;
      --bg-soft: #11100f;
      --card: #151413;
      --gold: #c9a96e;
      --gold-light: #e7d2a6;
      --cream: #f1ede5;
      --muted: #a6a096;
      --line: rgba(201,169,110,.25);
      --serif: "Cormorant Garamond", Georgia, serif;
      --sans: "DM Sans", Arial, sans-serif;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      background: var(--bg);
      color: var(--cream);
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.6;
      overflow-x: hidden;
    }

    body, button, input {
      font-family: var(--sans);
    }

    button, a {
      -webkit-tap-highlight-color: transparent;
    }

    button {
      color: inherit;
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      display: block;
      max-width: 100%;
    }

    .container {
      width: min(1240px, 90%);
      margin-inline: auto;
    }

    .serif {
      font-family: var(--serif);
      font-weight: 400;
    }

    .gold {
      color: var(--gold);
    }

    .eyebrow {
      color: var(--gold);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .section-heading {
      font-family: var(--serif);
      font-size: clamp(36px, 5vw, 57px);
      font-weight: 400;
      line-height: 1.08;
    }

    .section-intro {
      margin-top: 13px;
      color: var(--muted);
      font-size: 13px;
    }

    .section-top {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 24px;
      margin-bottom: 36px;
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding-bottom: 5px;
      border-bottom: 1px solid var(--gold);
      color: var(--gold-light);
      font-size: 11px;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: .3s;
    }

    .text-link:hover {
      color: white;
      gap: 16px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 27px;
      border: 1px solid var(--gold);
      background: var(--gold);
      color: #100e0a;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.7px;
      text-transform: uppercase;
      transition: background .3s, color .3s;
    }

    .btn:hover {
      background: transparent;
      color: var(--gold-light);
    }

    .btn-outline {
      background: transparent;
      color: var(--cream);
    }

    .btn-outline:hover {
      background: var(--gold);
      color: #100e0a;
    }

    /* ========== ANNOUNCEMENT BAR ========== */
    .announcement {
      min-height: 31px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 6px 15px;
      background: #b99a62;
      color: #100e0a;
      text-align: center;
      font-size: 9px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* ========== HEADER ========== */
    .header {
      position: sticky;
      z-index: 100;
      top: 0;
      background: rgba(9,9,9,.96);
      border-bottom: 1px solid rgba(255,255,255,.07);
      backdrop-filter: blur(14px);
    }

    .header-inner {
      width: min(1320px, 94%);
      min-height: 82px;
      margin: auto;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 25px;
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 25px;
    }

    .nav a {
      color: #d4cfc5;
      font-size: 10px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      transition: color .25s;
    }

    .nav a:hover {
      color: var(--gold-light);
    }

    .logo {
      font-family: var(--serif);
      font-size: 37px;
      font-weight: 400;
      letter-spacing: 8px;
      text-align: center;
      white-space: nowrap;
    }

    .logo span {
      color: var(--gold);
    }

    .header-actions {
      display: flex;
      justify-content: end;
      align-items: center;
      gap: 20px;
    }

    .icon-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px;
      border: 0;
      background: transparent;
      color: var(--cream);
    }

    .icon-btn:hover {
      color: var(--gold);
    }

    .icon-btn svg {
      width: 19px;
      height: 19px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .count {
      position: absolute;
      top: -5px;
      right: -6px;
      min-width: 16px;
      height: 16px;
      display: grid;
      place-items: center;
      padding: 0 4px;
      border-radius: 50%;
      background: var(--gold);
      color: #111;
      font-size: 9px;
    }

    .menu-toggle {
      display: none;
    }

    /* ========== SEARCH PANEL ========== */
    .search-panel {
      display: none;
      padding: 20px 5%;
      background: #111;
      border-top: 1px solid var(--line);
    }

    .search-panel.open {
      display: block;
    }

    .search-form {
      max-width: 700px;
      display: flex;
      gap: 10px;
      margin: auto;
    }

    .search-form input {
      width: 100%;
      min-width: 0;
      padding: 13px 15px;
      border: 1px solid #403b32;
      outline: none;
      background: #080808;
      color: white;
    }

    .search-form input:focus {
      border-color: var(--gold);
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 650px;
      display: flex;
      align-items: center;
      isolation: isolate;
      background: #12100e;
      overflow: hidden;
    }

    .hero::before {
      position: absolute;
      z-index: -2;
      inset: 0;
      content: "";
      background:
        linear-gradient(90deg, rgba(6,6,6,.95) 0%, rgba(6,6,6,.76) 37%, rgba(6,6,6,.12) 100%),
        url("https://images.unsplash.com/photo-1617038220319-276d3cfab638?auto=format&fit=crop&w=2000&q=90")
        center 43% / cover no-repeat;
      transform: scale(1.02);
    }

    .hero::after {
      position: absolute;
      z-index: -1;
      inset: 0;
      content: "";
      background: linear-gradient(0deg, var(--bg) 0%, transparent 18%, transparent 85%, rgba(0,0,0,.2) 100%);
    }

    .hero-content {
      width: min(1240px, 90%);
      margin: 0 auto;
      padding: 80px 0 110px;
    }

    .hero-kicker {
      display: flex;
      align-items: center;
      gap: 13px;
      margin-bottom: 25px;
    }

    .hero-kicker::before {
      width: 35px;
      height: 1px;
      background: var(--gold);
      content: "";
    }

    .hero h1 {
      max-width: 650px;
      font-family: var(--serif);
      font-size: clamp(58px, 8.2vw, 104px);
      font-weight: 300;
      line-height: .91;
      letter-spacing: -1.5px;
    }

    .hero h1 em {
      color: var(--gold-light);
      font-weight: 300;
    }

    .hero-description {
      max-width: 390px;
      margin-top: 28px;
      color: #c3bdb2;
      font-size: 13px;
      line-height: 2;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
      margin-top: 35px;
    }

    .hero-note {
      margin-top: 42px;
      color: #c9c0b0;
      font-family: var(--serif);
      font-size: 17px;
      font-style: italic;
    }

    /* ========== BRAND STRIP ========== */
    .brand-strip {
      padding: 22px 0;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: #0d0c0b;
    }

    .brand-strip-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-around;
      align-items: center;
      gap: 20px;
    }

    .brand-point {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #d0c9bc;
      font-size: 10px;
      letter-spacing: 1.3px;
      text-transform: uppercase;
    }

    .brand-point span {
      color: var(--gold);
      font-size: 17px;
    }

    /* ========== CATEGORIES ========== */
    .categories {
      padding: 100px 0 90px;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .category-card {
      position: relative;
      min-height: 410px;
      display: flex;
      align-items: end;
      padding: 28px;
      overflow: hidden;
      background: var(--card);
      isolation: isolate;
    }

    .category-card::before {
      position: absolute;
      z-index: -2;
      inset: 0;
      content: "";
      background-position: center;
      background-size: cover;
      transition: transform .7s;
    }

    .category-card:nth-child(1)::before {
      background-image: url("https://images.unsplash.com/photo-1611652022419-a9419f74343d?auto=format&fit=crop&w=850&q=85");
    }

    .category-card:nth-child(2)::before {
      background-image: url("https://images.unsplash.com/photo-1611591437281-460bfbe1220a?auto=format&fit=crop&w=850&q=85");
    }

    .category-card:nth-child(3)::before {
      background-image: url("https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=850&q=85");
    }

    .category-card::after {
      position: absolute;
      z-index: -1;
      inset: 0;
      content: "";
      background: linear-gradient(0deg, rgba(0,0,0,.91), transparent 75%);
    }

    .category-card:hover::before {
      transform: scale(1.07);
    }

    .category-card h3 {
      font-family: var(--serif);
      font-size: 37px;
      font-weight: 400;
    }

    .category-card p {
      margin: 5px 0 18px;
      color: #d0c9bd;
      font-size: 11px;
    }

    /* ========== PRODUCTS ========== */
    .products-section {
      padding: 80px 0 105px;
      background: #0e0d0c;
    }

    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 30px;
    }

    .filter-btn {
      padding: 9px 18px;
      border: 1px solid #39352e;
      background: transparent;
      color: #bdb6aa;
      font-size: 10px;
      letter-spacing: .7px;
      text-transform: uppercase;
      transition: .25s;
    }

    .filter-btn:hover,
    .filter-btn.active {
      border-color: var(--gold);
      background: var(--gold);
      color: #0d0c0a;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 25px 17px;
    }

    .product-card {
      min-width: 0;
    }

    .product-image {
      position: relative;
      aspect-ratio: 4 / 4.8;
      overflow: hidden;
      background: #191715;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .6s;
    }

    .product-card:hover .product-image img {
      transform: scale(1.05);
    }

    .product-tag {
      position: absolute;
      top: 12px;
      left: 12px;
      padding: 6px 9px;
      background: rgba(9,9,9,.86);
      color: var(--gold-light);
      font-size: 8px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .wishlist-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 35px;
      height: 35px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255,255,255,.22);
      border-radius: 50%;
      background: rgba(9,9,9,.65);
      font-size: 18px;
      transition: .25s;
    }

    .wishlist-btn:hover,
    .wishlist-btn.selected {
      border-color: var(--gold);
      color: var(--gold-light);
    }

    .quick-add {
      position: absolute;
      right: 10px;
      bottom: 10px;
      left: 10px;
      padding: 13px;
      border: 1px solid rgba(255,255,255,.3);
      background: rgba(9,9,9,.92);
      color: white;
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      opacity: 0;
      transform: translateY(8px);
      transition: .3s;
    }

    .product-card:hover .quick-add,
    .quick-add:focus {
      opacity: 1;
      transform: translateY(0);
    }

    .product-info {
      padding: 15px 2px;
    }

    .product-category {
      color: var(--gold);
      font-size: 9px;
      letter-spacing: 1.4px;
      text-transform: uppercase;
    }

    .product-name {
      margin-top: 5px;
      font-family: var(--serif);
      font-size: 23px;
      font-weight: 500;
      line-height: 1.2;
    }

    .product-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-top: 10px;
    }

    .product-price {
      color: #ded6c9;
      font-size: 12px;
    }

    .product-rating {
      color: var(--gold);
      font-size: 10px;
      white-space: nowrap;
    }

    .empty-results {
      grid-column: 1 / -1;
      padding: 50px 15px;
      color: var(--muted);
      text-align: center;
    }

    /* ========== EDITORIAL BANNER ========== */
    .editorial {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 560px;
      background: #151310;
    }

    .editorial-image {
      min-height: 450px;
      background: url("https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=1200&q=90") center / cover no-repeat;
    }

    .editorial-copy {
      display: flex;
      flex-direction: column;
      align-items: start;
      justify-content: center;
      padding: 70px clamp(30px, 7vw, 100px);
    }

    .editorial-copy h2 {
      margin-top: 23px;
      font-family: var(--serif);
      font-size: clamp(42px, 5vw, 65px);
      font-weight: 400;
      line-height: 1;
    }

    .editorial-copy p {
      max-width: 380px;
      margin: 24px 0 30px;
      color: #bcb5a9;
      font-size: 13px;
      line-height: 2;
    }

    /* ========== BRAND STORY ========== */
    .story {
      padding: 110px 0;
      text-align: center;
    }

    .story-inner {
      max-width: 800px;
      margin: auto;
    }

    .story h2 {
      margin-top: 20px;
      font-family: var(--serif);
      font-size: clamp(43px, 6vw, 73px);
      font-weight: 400;
      line-height: 1.05;
    }

    .story p {
      max-width: 610px;
      margin: 23px auto 30px;
      color: var(--muted);
      font-size: 13px;
      line-height: 2;
    }

    .story-mark {
      margin-top: 33px;
      color: var(--gold);
      font-family: var(--serif);
      font-size: 22px;
      letter-spacing: 4px;
    }

    /* ========== NEWSLETTER ========== */
    .newsletter {
      padding: 75px 0;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: #100f0d;
      text-align: center;
    }

    .newsletter h2 {
      margin-top: 10px;
      font-family: var(--serif);
      font-size: clamp(35px, 5vw, 50px);
      font-weight: 400;
    }

    .newsletter p {
      margin-top: 12px;
      color: var(--muted);
      font-size: 12px;
    }

    .newsletter-form {
      max-width: 470px;
      display: flex;
      margin: 27px auto 0;
      border-bottom: 1px solid #766347;
    }

    .newsletter-form input {
      width: 100%;
      min-width: 0;
      padding: 15px 5px;
      border: 0;
      outline: 0;
      background: transparent;
      color: white;
      font-size: 12px;
    }

    .newsletter-form button {
      padding: 0 8px 0 20px;
      border: 0;
      background: transparent;
      color: var(--gold-light);
      font-size: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* ========== FOOTER ========== */
    .footer {
      padding: 65px 0 25px;
      background: #080808;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 45px;
      padding-bottom: 50px;
    }

    .footer-logo {
      display: inline-block;
      margin-bottom: 18px;
      font-family: var(--serif);
      font-size: 34px;
      letter-spacing: 6px;
    }

    .footer-about {
      max-width: 290px;
      color: var(--muted);
      font-size: 12px;
      line-height: 2;
    }

    .footer-column h4 {
      margin-bottom: 20px;
      color: var(--gold-light);
      font-size: 10px;
      letter-spacing: 1.8px;
      text-transform: uppercase;
    }

    .footer-column a {
      display: block;
      width: fit-content;
      margin: 11px 0;
      color: #aaa399;
      font-size: 11px;
      transition: color .2s;
    }

    .footer-column a:hover {
      color: var(--gold-light);
    }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 15px;
      padding-top: 22px;
      border-top: 1px solid #29251e;
      color: #777168;
      font-size: 10px;
    }

    .social-links {
      display: flex;
      gap: 18px;
    }

    /* ========== CART DRAWER ========== */
    .overlay {
      position: fixed;
      z-index: 200;
      inset: 0;
      background: rgba(0,0,0,.68);
      opacity: 0;
      visibility: hidden;
      transition: .3s;
    }

    .overlay.open {
      opacity: 1;
      visibility: visible;
    }

    .cart-drawer {
      position: fixed;
      z-index: 201;
      top: 0;
      right: 0;
      width: min(440px, 100%);
      height: 100dvh;
      display: flex;
      flex-direction: column;
      background: #100f0d;
      border-left: 1px solid var(--line);
      transform: translateX(100%);
      transition: transform .35s ease;
    }

    .cart-drawer.open {
      transform: translateX(0);
    }

    .cart-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 23px;
      border-bottom: 1px solid var(--line);
    }

    .cart-header h3 {
      font-family: var(--serif);
      font-size: 29px;
      font-weight: 400;
    }

    .close-btn {
      width: 36px;
      height: 36px;
      border: 1px solid #39352e;
      border-radius: 50%;
      background: transparent;
      font-size: 20px;
    }

    .cart-items {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }

    .cart-empty {
      padding: 55px 10px;
      color: var(--muted);
      text-align: center;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 83px 1fr auto;
      gap: 14px;
      padding: 15px 0;
      border-bottom: 1px solid #2c2821;
    }

    .cart-item img {
      width: 83px;
      height: 100px;
      object-fit: cover;
    }

    .cart-item h4 {
      font-family: var(--serif);
      font-size: 21px;
      font-weight: 400;
      line-height: 1.15;
    }

    .cart-item p {
      margin-top: 8px;
      color: var(--gold-light);
      font-size: 12px;
    }

    .quantity {
      display: flex;
      align-items: center;
      gap: 13px;
      margin-top: 12px;
    }

    .quantity button,
    .remove-item {
      border: 0;
      background: transparent;
      color: #d4c8b5;
    }

    .quantity button {
      font-size: 17px;
    }

    .remove-item {
      align-self: start;
      font-size: 17px;
    }

    .cart-footer {
      padding: 22px;
      border-top: 1px solid var(--line);
    }

    .cart-total {
      display: flex;
      justify-content: space-between;
      margin-bottom: 16px;
      font-size: 13px;
    }

    .cart-total strong {
      color: var(--gold-light);
      font-size: 17px;
    }

    .cart-footer .btn {
      width: 100%;
    }

    .cart-disclaimer {
      margin-top: 12px;
      color: #888176;
      font-size: 10px;
      text-align: center;
    }

    /* ========== NOTIFICATION ========== */
    .toast {
      position: fixed;
      z-index: 300;
      right: 20px;
      bottom: 20px;
      max-width: min(350px, calc(100% - 40px));
      padding: 15px 20px;
      border: 1px solid var(--line);
      background: #171511;
      color: var(--cream);
      font-size: 12px;
      box-shadow: 0 10px 40px rgba(0,0,0,.35);
      opacity: 0;
      pointer-events: none;
      transform: translateY(15px);
      transition: .3s;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0);
