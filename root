                data-wishlist="${product.id}"
                aria-label="${isWishlisted ? "Remove from" : "Add to"} wishlist"
                aria-pressed="${isWishlisted}"
              >${isWishlisted ? "♥" : "♡"}</button>

              <button class="quick-add" data-add="${product.id}">
