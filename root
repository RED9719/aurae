            <div class="product-image">
              <img
                src="${escapeHTML(product.image)}"
                alt="${escapeHTML(product.name)}"
                loading="lazy"
                onerror="this.onerror=null;this.src='https://placehold.co/600x750/171511/c9a96e?text=Auraè';"
